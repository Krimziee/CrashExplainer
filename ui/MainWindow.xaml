<!--
    Standalone Crash Explainer window: an empty frame that shows Page.xaml.
    (In Krimz's Toolkit the same page is shown in the Crash Explainer tab.)
-->
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crash Explainer" Width="1120" Height="760" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Background}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="#F3F3F3"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
</Window>
