<!--
    Crash Explainer page. Used by the standalone window (MainWindow.xaml) and by
    the Crash Explainer tab in Krimz's Toolkit. Crash list on the left, the selected
    crash's explanation and fixes on the right. Controls with x:Name are found and
    wired up by modules\Ui.ps1; list rows and the detail panel are built there.
    Shared styles come from Theme.xaml (loaded as the application's resources);
    the ones only this page uses are below.
-->
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Background}" Foreground="#F3F3F3"
             FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" MinHeight="520">

    <UserControl.Resources>
        <!-- Pill-shaped choice buttons (period and sort order) -->
        <Style x:Key="Pill" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="14" Padding="14,4">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A3550"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                <Setter Property="Foreground" Value="#F3F3F3"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One crash in the list -->
        <Style x:Key="CrashItem" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2C"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2C2C2C"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Labels sit next to the choices on one line -->
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="28,22,28,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Crash Explainer" FontFamily="Segoe UI Variable Display, Segoe UI" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="13" Margin="10,0,0,4" VerticalAlignment="Bottom"/>
            </StackPanel>
            <TextBlock Foreground="{StaticResource Muted}" Margin="0,4,0,0"
                       Text="Your recent crashes explained in plain words. This tool only reads Windows' logs - nothing on your PC is changed."/>
        </StackPanel>

        <!-- Period, sort order, refresh -->
        <DockPanel Grid.Row="1" Margin="0,18,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="SHOW THE LAST" Style="{StaticResource Label}"/>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <RadioButton x:Name="Days7"  Style="{StaticResource Pill}" GroupName="Days" Tag="7"  Content="7 days"/>
                <RadioButton x:Name="Days14" Style="{StaticResource Pill}" GroupName="Days" Tag="14" Content="14 days"/>
                <RadioButton x:Name="Days30" Style="{StaticResource Pill}" GroupName="Days" Tag="30" Content="30 days"/>
                <RadioButton x:Name="Days90" Style="{StaticResource Pill}" GroupName="Days" Tag="90" Content="90 days"/>
            </StackPanel>
            <TextBlock DockPanel.Dock="Left" Text="SORT BY" Style="{StaticResource Label}" Margin="24,0,10,0"/>
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <RadioButton x:Name="SortSeverity" Style="{StaticResource Pill}" GroupName="Sort" Content="Most serious"/>
                <RadioButton x:Name="SortRecent"   Style="{StaticResource Pill}" GroupName="Sort" Content="Most recent"/>
            </StackPanel>
            <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="Refresh"/>
        </DockPanel>

        <!-- Totals and "the big picture" -->
        <StackPanel Grid.Row="2" Margin="0,14,0,14">
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource Muted}" FontSize="13" TextWrapping="Wrap"/>
            <Border x:Name="BigPictureCard" Style="{StaticResource Card}" Margin="0,10,0,0" Visibility="Collapsed"
                    Background="#2A2615" BorderBrush="#5C4F1A">
                <StackPanel>
                    <TextBlock Text="THE BIG PICTURE" Foreground="#FCE100" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <StackPanel x:Name="BigPicturePanel"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Crash list + details -->
        <Grid x:Name="MainArea" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <ListBox x:Name="CrashList" Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="0"
                     ItemContainerStyle="{StaticResource CrashItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18,8,18">
                <ScrollViewer x:Name="DetailScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="DetailPanel" Margin="0,0,14,0"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Shown instead of the list while reading, or when there is nothing to show -->
        <StackPanel x:Name="StatusPanel" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock x:Name="StatusTitle" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" Margin="0,6,0,0" MaxWidth="520"
                       TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"/>
            <ProgressBar x:Name="ReadProgress" Width="320" Margin="0,16,0,0" Maximum="100" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</UserControl>
